PORT=4000
NODE_ENV=production

# Set these in Render Environment, do not commit your real .env file.
MONGO_URI=mongodb+srv://<user>:<pass>@water-monitor.uyei05r.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=test
JWT_ACCESS_SECRET=very_strong_random_here
JWT_REFRESH_SECRET=another_strong_value
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Google OAuth2 Web Client ID
GOOGLE_WEB_CLIENT_ID=

# Comma-separated origins for browser clients. React Native does not need CORS,
# but keep this for web dashboards/admin tools if you add them.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Optional AI/ML integrations
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
PYTHON_BIN=python3

# Optional MQTT ingestion. Keep disabled unless you have a public broker URL.
MQTT_ENABLED=false
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
